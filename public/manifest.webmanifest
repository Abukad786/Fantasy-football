{
  "name": "Gaffer – FPL rival tracker",
  "short_name": "Gaffer",
  "description": "Fantasy Premier League news, Opta-based insights and mini-league rival comparison.",
  "start_url": "./#home",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1b0f2e",
